<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage x:Class="Library.Views.BookDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:base="clr-namespace:Library.Views"
             xmlns:vm="clr-namespace:Library.ViewModels"
             xmlns:models="clr-namespace:Library.Models"
             x:DataType="vm:BookDetailViewModel"
             Title="Детали книги"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ScrollView>
        <StackLayout Padding="20" Spacing="20">
            
            <!-- Заголовок книги -->
            <Border BackgroundColor="{DynamicResource CardBackgroundColor}" 
                   Padding="20" 
                   StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <StackLayout>
                    <Label Text="{Binding BookTitle}" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="{DynamicResource PrimaryTextColor}" />
                    <Label Text="{Binding BookAuthor}" 
                           FontSize="18" 
                           TextColor="{DynamicResource SecondaryTextColor}" 
                           Margin="0,5,0,0" />
                </StackLayout>
            </Border>

            <!-- Прогресс чтения -->
            <Border BackgroundColor="{DynamicResource CardBackgroundColor}" 
                   Padding="20" 
                   StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <StackLayout>
                    <Label Text="📊 Прогресс чтения" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="{DynamicResource PrimaryTextColor}" />
                    
                    <ProgressBar Progress="{Binding Progress}" 
                                 Margin="0,15,0,10"
                                 ProgressColor="{DynamicResource TertiaryColor}" />
                    
                    <Label Text="{Binding ProgressText}" 
                           FontSize="16" 
                           TextColor="{DynamicResource PrimaryTextColor}" 
                           HorizontalOptions="Center" />

                    <Label Text="{Binding RemainingPagesText}"
                           FontSize="14"
                           TextColor="{DynamicResource PrimaryTextColor}"
                           HorizontalOptions="Center"
                           Margin="0,6,0,0"
                           IsVisible="{Binding IsRemainingPagesVisible}" />
                    
                    <Label Text="{Binding ProgressPercentage}" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           TextColor="{DynamicResource PrimaryTextColor}" 
                           HorizontalOptions="Center"
                           Margin="0,10,0,0" />
                    
                    <Label Text="{Binding EstimatedFinishDate}"
                           FontSize="14"
                           TextColor="{DynamicResource PrimaryTextColor}"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0"
                           IsVisible="{Binding IsEstimatedFinishDateVisible}" />
                    
                    <Button Text="📝 Обновить прогресс" 
                            BackgroundColor="{DynamicResource PrimaryColor}" 
                            TextColor="{DynamicResource SecondaryTextColor}" 
                            CornerRadius="10" 
                            Margin="0,15,0,0" 
                            IsVisible="{Binding IsUpdateProgressVisible}"
                            Command="{Binding UpdateProgressCommand}" />
                    
                    <Button Text="⏰ График чтения по часам" 
                            BackgroundColor="{DynamicResource TertiaryColor}" 
                            TextColor="{DynamicResource PrimaryTextColor}" 
                            CornerRadius="10" 
                            Margin="0,10,0,0" 
                            IsVisible="{Binding IsReadingScheduleVisible}"
                            Command="{Binding GoToReadingScheduleCommand}" />
                    
                    <Button Text="🔄 Альтернативный расчет страниц" 
                            BackgroundColor="{DynamicResource SecondaryColor}" 
                            TextColor="{DynamicResource PrimaryTextColor}" 
                            CornerRadius="10" 
                            Margin="0,10,0,0" 
                            IsVisible="{Binding IsAlternativeCalculationVisible}"
                            Command="{Binding GoToAlternativeCalculationCommand}" />

                    <Button Text="🔁 Перечитать"
                            BackgroundColor="{DynamicResource AccentColor}"
                            TextColor="{DynamicResource PrimaryTextColor}"
                            CornerRadius="10"
                            Margin="0,10,0,0"
                            IsVisible="{Binding IsRestartReadingVisible}"
                            Command="{Binding RestartReadingCommand}" />
                </StackLayout>
            </Border>

            <!-- Прочтения -->
            <Border BackgroundColor="{DynamicResource CardBackgroundColor}"
                   Padding="20"
                   StrokeThickness="0"
                   IsVisible="{Binding IsReadingSessionsVisible}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <StackLayout>
                    <Label Text="📚 Прочтения"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource PrimaryTextColor}" />

                    <ScrollView Orientation="Horizontal"
                                Margin="0,10,0,0"
                                IsVisible="{Binding IsSessionPickerVisible}">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding ReadingSessions}"
                                               Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ReadingSessionDisplayItem">
                                    <Button Text="{Binding Title}"
                                            FontSize="12"
                                            Padding="12,6"
                                            CornerRadius="8"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type base:BookDetailPage}}, Path=BindingContext.SelectReadingSessionCommand}"
                                            CommandParameter="{Binding .}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                                                <Setter Property="TextColor" Value="{DynamicResource SecondaryTextColor}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="False">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource PageBackgroundColor}" />
                                                <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ReadingSessions}"
                                         Margin="0,10,0,0"
                                         Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ReadingSessionDisplayItem">
                                <Border BackgroundColor="{DynamicResource PageBackgroundColor}"
                                        Padding="12"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <StackLayout>
                                        <Label Text="{Binding Title}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource PrimaryTextColor}" />
                                        <Label Text="{Binding DateRangeText}"
                                               FontSize="13"
                                               TextColor="{DynamicResource SecondaryTextColor}" />
                                        <Label Text="{Binding StatsText}"
                                               FontSize="13"
                                               TextColor="{DynamicResource PrimaryTextColor}" />
                                    </StackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </StackLayout>
            </Border>

            <!-- График чтения по дням -->
            <Border BackgroundColor="{DynamicResource CardBackgroundColor}" 
                   Padding="20" 
                   StrokeThickness="0"
                   IsVisible="{Binding IsChartVisible}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <StackLayout>
                    <Label Text="📈 График чтения" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="{DynamicResource PrimaryTextColor}" />
                    
                    <Label Text="{Binding ChartDescription}"
                           FontSize="12"
                           TextColor="{DynamicResource SecondaryTextColor}"
                           Margin="0,5,0,5" />
                    
                    <Label Text="{Binding AverageDailyText}"
                           FontSize="12"
                           TextColor="{DynamicResource SecondaryTextColor}"
                           Margin="0,0,0,10" />
                    
                    <ScrollView Orientation="Horizontal" 
                                HorizontalScrollBarVisibility="Always"
                                Margin="0,10,0,0">
                        <ContentView>
                            <ContentView.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenReadingHistoryCommand}" />
                            </ContentView.GestureRecognizers>
                            <GraphicsView x:Name="ReadingChartView"
                                          HeightRequest="250"
                                          WidthRequest="{Binding ChartWidth}"
                                          Drawable="{Binding ChartDrawable}"
                                          BackgroundColor="Transparent"
                                          InputTransparent="True" />
                        </ContentView>
                    </ScrollView>
                    
                    <Label Text="Нажмите на график, чтобы отредактировать историю чтения по дням (доступно только для книг в статусе &quot;Читаю сейчас&quot;)"
                           FontSize="12"
                           TextColor="{DynamicResource SecondaryTextColor}"
                           Margin="0,10,0,0"
                           IsVisible="{Binding IsChartHintVisible}" />
                </StackLayout>
            </Border>

            <!-- Информация о книге -->
            <Border BackgroundColor="{DynamicResource CardBackgroundColor}" 
                   Padding="20" 
                   StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <StackLayout>
                    <Label Text="📖 Информация о книге" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="{DynamicResource PrimaryTextColor}" />
                    
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,*,*,*,*,*,*,*" 
                          ColumnSpacing="10" RowSpacing="10" Margin="0,15,0,0">
                        
                        <Label Grid.Row="0" Grid.Column="0" 
                               Text="Всего страниц:" FontSize="14" 
                               TextColor="{DynamicResource SecondaryTextColor}" />
                        <Label Grid.Row="0" Grid.Column="1" 
                               Text="{Binding TotalPages}" FontSize="14" 
                               TextColor="{DynamicResource PrimaryTextColor}" />
                        
                        <Label Grid.Row="1" Grid.Column="0" 
                               Text="Статус:" FontSize="14" 
                               TextColor="{DynamicResource SecondaryTextColor}" />
                        <Label Grid.Row="1" Grid.Column="1" 
                               Text="{Binding StatusText}" FontSize="14" 
                               TextColor="{DynamicResource PrimaryTextColor}" />
                        
                        <Label Grid.Row="2" Grid.Column="0" 
                               Text="Дата добавления:" FontSize="14" 
                               TextColor="{DynamicResource SecondaryTextColor}" />
                        <Label Grid.Row="2" Grid.Column="1" 
                               Text="{Binding DateAdded}" FontSize="14" 
                               TextColor="{DynamicResource PrimaryTextColor}" />
                        
                        <Label Grid.Row="3" Grid.Column="0"
                               Text="Дата начала чтения:" FontSize="14"
                               TextColor="{DynamicResource SecondaryTextColor}"
                               IsVisible="{Binding IsDateStartedVisible}" />
                        <Label Grid.Row="3" Grid.Column="1"
                               Text="{Binding DateStarted}" FontSize="14"
                               TextColor="{DynamicResource PrimaryTextColor}"
                               IsVisible="{Binding IsDateStartedVisible}" />

                        <Label Grid.Row="4" Grid.Column="0" 
                               Text="Дата завершения:" FontSize="14" 
                               TextColor="{DynamicResource SecondaryTextColor}"
                               IsVisible="{Binding IsDateFinishedVisible}" />
                        <Label Grid.Row="4" Grid.Column="1"
                               Text="{Binding DateFinished}" FontSize="14"
                               TextColor="{DynamicResource PrimaryTextColor}"
                               IsVisible="{Binding IsDateFinishedVisible}" />
                        
                        <Label Grid.Row="5" Grid.Column="0" 
                               Text="Цикл:" FontSize="14" 
                               TextColor="{DynamicResource SecondaryTextColor}" />
                        <Label Grid.Row="5" Grid.Column="1" 
                               Text="{Binding SeriesTitle}" FontSize="14" 
                               TextColor="{DynamicResource PrimaryTextColor}" />
                        
                        <Label Grid.Row="6" Grid.Column="0" 
                               Text="Номер в цикле:" FontSize="14" 
                               TextColor="{DynamicResource SecondaryTextColor}" />
                        <Label Grid.Row="6" Grid.Column="1" 
                               Text="{Binding SeriesNumber}" FontSize="14" 
                               TextColor="{DynamicResource PrimaryTextColor}" />
                        
                        <Label Grid.Row="7" Grid.Column="0" 
                               Text="Полка:" FontSize="14" 
                               TextColor="{DynamicResource SecondaryTextColor}" />
                        <Label Grid.Row="7" Grid.Column="1" 
                               Text="{Binding ShelfName}" FontSize="14" 
                               TextColor="{DynamicResource PrimaryTextColor}" />
                    </Grid>
                </StackLayout>
            </Border>

            <!-- Заметки -->
            <Border BackgroundColor="{DynamicResource CardBackgroundColor}"
                   Padding="20"
                   StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenEditNotesCommand}" />
                </Border.GestureRecognizers>
                <StackLayout>
                    <Label Text="Заметки"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource PrimaryTextColor}" />

                    <Label Text="{Binding NotesText}"
                           FontSize="14"
                           LineBreakMode="WordWrap"
                           TextColor="{DynamicResource PrimaryTextColor}"
                           Margin="0,15,0,0"
                           IsVisible="{Binding HasNotes}" />

                    <Label Text="Нажмите для редактирования"
                           FontSize="12"
                           LineBreakMode="WordWrap"
                           TextColor="{DynamicResource SecondaryTextColor}"
                           Margin="0,15,0,0"
                           IsVisible="{Binding IsNotesEmpty}" />
                </StackLayout>
            </Border>

            <!-- Действия -->
            <StackLayout Orientation="Horizontal" Spacing="10">
                <Button Text="✏️ Редактировать" 
                        BackgroundColor="{DynamicResource SecondaryColor}" 
                        TextColor="{DynamicResource PrimaryTextColor}" 
                        CornerRadius="10" 
                        HorizontalOptions="Fill" 
                        Command="{Binding EditBookCommand}" />
                <Button Text="🗑️ Удалить" 
                        BackgroundColor="{DynamicResource ErrorColor}" 
                        TextColor="{DynamicResource PrimaryTextColor}" 
                        CornerRadius="10" 
                        HorizontalOptions="Fill" 
                        Command="{Binding DeleteBookCommand}" />
            </StackLayout>

        </StackLayout>
    </ScrollView>

</base:BasePage>
